PORT=4000
NODE_ENV=development
APP_NAME=real-estate-platform
API_BASE_URL=http://localhost:4000
ASSET_STORAGE_PATH=./server/assets

# Production server-only Supabase credentials.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY in the frontend or commit a real value.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Platform owner secret for global company/project visibility.
PLATFORM_API_KEY=replace-with-a-long-random-secret

# Comma-separated allowed browser origins. Empty means permissive (use only for local development).
CORS_ORIGINS=http://localhost:5173

# Optional frontend override; normally keep empty so Vite uses /api on the same domain.
VITE_API_BASE_URL=
